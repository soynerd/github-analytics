generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AnalyticsCache {
  id        String   @id @default(cuid())
  username  String   @unique
  data      Json
  cachedAt  DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
